{
  "name": "animacion-reflexiva",
  "version": "1.0.0",
  "description": "2D reflective shorts in Remotion (9:16)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ReflexionDialogo out/dialogo.mp4",
    "tts": "python3 tools/tts/generate.py",
    "typecheck": "tsc --noEmit -p .",
    "paper:studio": "remotion studio src/papercut/index.ts",
    "paper:render": "remotion render src/papercut/index.ts PaperWalkTest out/paper-walk-test.mp4",
    "paper:render:ep01": "remotion render src/papercut/index.ts PaperEp01 out/paper-ep01.mp4",
    "paper:audio": "python3 tools/audio/make_ambience.py",
    "pandero:studio": "remotion studio src/pandero/index.ts",
    "pandero:tts": "python3 tools/pandero/tts.py",
    "pandero:music": "python3 tools/pandero/music.py 86",
    "yabajaste:studio": "remotion studio src/yabajaste/index.ts",
    "yabajaste:tts": "python3 tools/yabajaste/tts.py",
    "yabajaste:audio": "python3 -I tools/yabajaste/audio.py nota lips corto",
    "yabajaste:prueba": "remotion render src/yabajaste/index.ts YaBajastePrueba out/yabajaste_prueba.mp4 --crf=18",
    "yabajaste:timeline": "python3 -I tools/yabajaste/timeline.py",
    "yabajaste:render": "remotion render src/yabajaste/index.ts YaBajaste out/Ya_bajaste_completo.mp4 --crf=18 --audio-bitrate=256k"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/360connectpe-sys/Animaci-n.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/360connectpe-sys/Animaci-n/issues"
  },
  "homepage": "https://github.com/360connectpe-sys/Animaci-n#readme",
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@react-spring/web": "^10.1.2",
    "@remotion/cli": "^4.0.543",
    "@remotion/player": "^4.0.543",
    "lucide-react": "^1.72.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.543"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^7.0.2"
  },
  "private": true
}
