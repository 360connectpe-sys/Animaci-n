 "subs": [
  {
   "a": 1.958,
   "b": 4.368,
   "text": "Hoy el micro pasó por tu cuadra.",
   "who": "el"
  },
  {
   "a": 5.073,
   "b": 8.553,
   "text": "Sigue apagada la mitad\ndel letrero de la panadería.",
   "who": "el"
  },
  {
   "a": 9.861,
   "b": 13.008,
   "text": "Busqué «ya bajaste»\nen nuestro chat.",
   "who": "el"
  },
  {
   "a": 13.713,
   "b": 15.589,
   "text": "Me salieron un montón.",
   "who": "el"
  },
  {
   "a": 16.286,
   "b": 19.578,
   "text": "Creo que te escribí lo mismo\ntodos los sábados.",
   "who": "el"
  },
  {
   "a": 20.168,
   "b": 21.026,
   "text": "Ya bajo.",
   "who": "ella"
  },
  {
   "a": 21.404,
   "b": 22.719,
   "text": "Oye… si sale mi mamá,",
   "who": "ella"
  },
  {
   "a": 22.759,
   "b": 24.555,
   "text": "dile que recién llegas, ¿ya?",
   "who": "ella"
  },
  {
   "a": 30.881,
   "b": 32.1,
   "text": "¿Recién llego?",
   "who": "el"
  },
  {
   "a": 32.723,
   "b": 34.781,
   "text": "Ya hasta me conoce el panadero.",
   "who": "el"
  },
  {
   "a": 37.574,
   "b": 39.536,
   "text": "Entonces ya sabes cuál me gusta.",
   "who": "ella"
  },
  {
   "a": 44.595,
   "b": 46.298,
   "text": "Siempre hacías eso.",
   "who": "el"
  },
  {
   "a": 47.026,
   "b": 48.817,
   "text": "Me ponías la mano acá",
   "who": "el"
  },
  {
   "a": 48.857,
   "b": 51.993,
   "text": "y yo ya sabía que tenía\nque quedarme quieto.",
   "who": "el"
  },
  {
   "a": 55.702,
   "b": 59.443,
   "text": "Me acuerdo de que esa noche\nmiré la hora tres veces.",
   "who": "el"
  },
  {
   "a": 60.171,
   "b": 62.169,
   "text": "Veinte minutos esperándote,",
   "who": "el"
  },
  {
   "a": 62.209,
   "b": 64.518,
   "text": "con el pan todavía caliente.",
   "who": "el"
  },
  {
   "a": 65.578,
   "b": 67.456,
   "text": "Quién me iba a decir que un día",
   "who": "el"
  },
  {
   "a": 67.496,
   "b": 71.675,
   "text": "iba a extrañar hasta la parte\nen que todavía no bajabas.",
   "who": "el"
  },
  {
   "a": 72.865,
   "b": 73.723,
   "text": "Ya bajo.",
   "who": "ella"
  },
  {
   "a": 74.101,
   "b": 74.67,
   "text": "Oye…",
   "who": "ella"
  }
 ]
